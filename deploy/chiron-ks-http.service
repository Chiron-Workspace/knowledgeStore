# HTTP layer cho Mnemosyne (Rust/Actix — runtime khác, bắt buộc qua HTTP).
#
# Type=simple: `ks serve` block vô hạn, KHÔNG phải cron job.
# Hai route ghi không chạm LLM nên unit này KHÔNG cần biến LLM nào.
#
# BẪY: sửa code xong service vẫn chạy code CŨ cho tới khi `systemctl --user
# restart chiron-ks-http`. Verify bằng curl mà quên restart là test nhầm code cũ.

[Unit]
Description=Chiron Knowledge Store — HTTP API
After=chiron-ks-postgres.service
Requires=chiron-ks-postgres.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/Chiron/KnowledgeStore
EnvironmentFile=%h/Projects/Chiron/KnowledgeStore/.env
ExecStart=%h/Projects/Chiron/KnowledgeStore/.venv/bin/python -m ks.cli serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
